# Kopjo si .env (ose vendosi nga faqja "Rrjetet sociale", paneli "Lidhjet").
# Ky skedar lexohet vetëm nga serveri lokal; vlerat nuk i dërgohen shfletuesit.

# Apify: postime publike në Instagram, Facebook, LinkedIn, TikTok (apify.com, Settings, API & Integrations)
APIFY_TOKEN=

# Meta Graph API (opsionale, zyrtare): vetëm për faqen / llogarinë tuaj
META_ACCESS_TOKEN=
FB_PAGE_ID=
IG_USER_ID=
# META_GRAPH_VERSION=v23.0

# Actor-ë alternativë në Apify (opsionale)
# Instagram përdor si parazgjedhje apify/instagram-scraper (resultsType: comments)
# APIFY_INSTAGRAM_ACTOR=apify/instagram-comment-scraper
# APIFY_FACEBOOK_ACTOR=apify/facebook-comments-scraper
# APIFY_TIKTOK_ACTOR=clockworks/tiktok-comments-scraper
# APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-post-comments

# LLM lokal (opsionale)
# OLLAMA_MODEL=llama3.2
